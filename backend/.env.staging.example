# Copy to backend/.env.staging, then set all four independent secrets below.
# Every Compose command uses:
# docker compose --env-file backend/.env.staging -f docker-compose.staging.yml ...

# The database owner is used only by postgres and the one-shot migration service.
STAGING_DB_ADMIN_USER=payd_staging_owner
STAGING_DB_ADMIN_PASSWORD=
STAGING_DB_NAME=payd_staging

# Separate API role: no ownership, superuser, role creation, or RLS bypass.
STAGING_DB_USER=payd_staging
STAGING_DB_PASSWORD=

# Auth is enforced by the existing production middleware. Use distinct secrets.
JWT_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGIN=http://localhost:5173

# Use Stellar testnet for this isolated stack.
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SDS_API_KEY=
SDS_ENDPOINT=https://sds-api.stellar.org
SDS_ENABLE=true
